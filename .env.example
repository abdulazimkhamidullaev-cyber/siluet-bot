# Token from @BotFather
BOT_TOKEN=123456:ABC...
# Public HTTPS address where this server is reachable (Telegram requires https)
WEBAPP_URL=https://your-domain.uz
# Chats that receive orders: each admin sends /id to the bot. Several admins: comma-separated, e.g. 123456789,987654321
ADMIN_CHAT_ID=0
PORT=8000
# 1 = allow placing test orders from a normal browser (keep 0 in production)
DEV_MODE=0
